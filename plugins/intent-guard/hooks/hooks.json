{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/capture-prompt.sh", "timeout": 10 } ] }
    ],
    "PreToolUse": [
      { "matcher": "ExitPlanMode",
        "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/plan-gate.sh", "timeout": 60 } ] }
    ],
    "PostToolUse": [
      { "matcher": "TaskUpdate",
        "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/task-checkpoint.sh", "timeout": 60 } ] },
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/mark-work.sh", "timeout": 5 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/delivery-audit.sh", "timeout": 60 } ] }
    ]
  }
}
